<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_community_budget_tree" model="ir.ui.view">
        <field name="name">community.budget.list</field>
        <field name="model">community.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_planned"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_community_budget_form" model="ir.ui.view">
        <field name="name">community.budget.form</field>
        <field name="model">community.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Done" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="account_id"/>
                            <field name="analytic_account_id"/>
                            <field name="planned_amount"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_community_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">community.budget</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_community_budget" name="Budgets" parent="account.menu_finance_entries" action="action_community_budget" sequence="50"/>
</odoo>
