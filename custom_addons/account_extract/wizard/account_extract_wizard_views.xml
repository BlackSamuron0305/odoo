<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_extract_wizard_form" model="ir.ui.view">
        <field name="name">account.extract.wizard.form</field>
        <field name="model">account.extract.wizard</field>
        <field name="arch" type="xml">
            <form string="Digitize Vendor Bill">
                <group>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                    <field name="partner_id"/>
                    <field name="reference"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_create_bill" type="object" string="Create Draft Bill" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_extract_wizard" model="ir.actions.act_window">
        <field name="name">Digitize Vendor Bill</field>
        <field name="res_model">account.extract.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_account_extract"
        name="Digitize Bill"
        action="action_account_extract_wizard"
        parent="account.menu_finance_payables"
        sequence="25"
        groups="account.group_account_invoice"
    />
</odoo>
