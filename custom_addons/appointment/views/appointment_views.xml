<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_appointment_type_tree" model="ir.ui.view">
        <field name="name">appointment.type.list</field>
        <field name="model">appointment.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="duration"/>
                <field name="user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_appointment_type_form" model="ir.ui.view">
        <field name="name">appointment.type.form</field>
        <field name="model">appointment.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="duration"/>
                        <field name="user_ids" widget="many2many_tags"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_appointment_type" model="ir.actions.act_window">
        <field name="name">Appointment Types</field>
        <field name="res_model">appointment.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_appointment_root" name="Appointments" web_icon="base,static/img/icons/appointment.png" sequence="215"/>
    <menuitem id="menu_appointment_types" name="Appointment Types" parent="menu_appointment_root" action="action_appointment_type" sequence="10"/>
    <menuitem id="menu_appointment_calendar" name="Calendar" parent="menu_appointment_root" action="calendar.action_calendar_event" sequence="20"/>
</odoo>
