<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_appraisal_tree" model="ir.ui.view">
        <field name="name">hr.appraisal.list</field>
        <field name="model">hr.appraisal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="date_close"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hr_appraisal_form" model="ir.ui.view">
        <field name="name">hr.appraisal.form</field>
        <field name="model">hr.appraisal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="manager_id"/>
                        <field name="date_close"/>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hr_appraisal" model="ir.actions.act_window">
        <field name="name">Appraisals</field>
        <field name="res_model">hr.appraisal</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_appraisal_root" name="Appraisal" web_icon="base,static/img/icons/hr_appraisal.png" sequence="180"/>
    <menuitem id="menu_hr_appraisal_main" name="Appraisals" parent="menu_hr_appraisal_root" action="action_hr_appraisal" sequence="10"/>
</odoo>
