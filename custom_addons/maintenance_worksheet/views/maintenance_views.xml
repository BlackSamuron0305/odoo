<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_equipment_request_view_form_worksheet" model="ir.ui.view">
        <field name="name">maintenance.request.form.worksheet</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Worksheet" name="worksheet">
                    <group>
                        <field name="checklist_done"/>
                    </group>
                    <field name="worksheet"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
