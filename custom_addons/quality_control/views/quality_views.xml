<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quality_point_tree" model="ir.ui.view">
        <field name="name">quality.point.list</field>
        <field name="model">quality.point</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_quality_point_form" model="ir.ui.view">
        <field name="name">quality.point.form</field>
        <field name="model">quality.point</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="product_ids" widget="many2many_tags"/>
                        <field name="picking_type_ids" widget="many2many_tags"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_quality_check_tree" model="ir.ui.view">
        <field name="name">quality.check.list</field>
        <field name="model">quality.check</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="point_id"/>
                <field name="product_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_quality_check_form" model="ir.ui.view">
        <field name="name">quality.check.form</field>
        <field name="model">quality.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pass" type="object" string="Pass" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_fail" type="object" string="Fail" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="point_id"/>
                        <field name="product_id"/>
                        <field name="picking_id"/>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_quality_point" model="ir.actions.act_window">
        <field name="name">Control Points</field>
        <field name="res_model">quality.point</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_quality_check" model="ir.actions.act_window">
        <field name="name">Quality Checks</field>
        <field name="res_model">quality.check</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_quality_root" name="Quality" web_icon="base,static/img/icons/quality_control.png" sequence="120"/>
    <menuitem id="menu_quality_check" name="Quality Checks" parent="menu_quality_root" action="action_quality_check" sequence="10"/>
    <menuitem id="menu_quality_point" name="Control Points" parent="menu_quality_root" action="action_quality_point" sequence="20"/>
</odoo>
