<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amazon_order_tree" model="ir.ui.view">
        <field name="name">amazon.order.list</field>
        <field name="model">amazon.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_amazon_order_form" model="ir.ui.view">
        <field name="name">amazon.order.form</field>
        <field name="model">amazon.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_sale_order" type="object" string="Create Sales Order" class="btn-primary" invisible="sale_order_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="sale_order_id"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_amazon_order" model="ir.actions.act_window">
        <field name="name">Amazon Orders</field>
        <field name="res_model">amazon.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sale_amazon_root" name="Amazon" web_icon="base,static/img/icons/sale_amazon.png" sequence="320"/>
    <menuitem id="menu_sale_amazon_orders" name="Orders" parent="menu_sale_amazon_root" action="action_amazon_order" sequence="10"/>
</odoo>
