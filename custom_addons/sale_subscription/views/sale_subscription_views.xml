<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_subscription_tree" model="ir.ui.view">
        <field name="name">sale.subscription.list</field>
        <field name="model">sale.subscription</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="next_invoice_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_sale_subscription_form" model="ir.ui.view">
        <field name="name">sale.subscription.form</field>
        <field name="model">sale.subscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="recurring_interval"/>
                        <field name="recurring_rule_type"/>
                        <field name="next_invoice_date"/>
                    </group>
                    <field name="sale_order_ids"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sale_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">sale.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sale_subscription_root" name="Subscriptions" web_icon="base,static/img/icons/sale_subscription.png" sequence="115"/>
    <menuitem id="menu_sale_subscription_main" name="Subscriptions" parent="menu_sale_subscription_root" action="action_sale_subscription" sequence="10"/>
</odoo>
