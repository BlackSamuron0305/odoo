<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_post_tree" model="ir.ui.view">
        <field name="name">social.post.list</field>
        <field name="model">social.post</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="platform"/>
                <field name="scheduled_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_social_post_form" model="ir.ui.view">
        <field name="name">social.post.form</field>
        <field name="model">social.post</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule" type="object" string="Schedule" invisible="state != 'draft'"/>
                    <button name="action_post" type="object" string="Mark Posted" class="btn-primary" invisible="state == 'posted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="platform"/>
                        <field name="scheduled_date"/>
                        <field name="utm_campaign_id"/>
                    </group>
                    <field name="body"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_social_post" model="ir.actions.act_window">
        <field name="name">Social Posts</field>
        <field name="res_model">social.post</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_social_root" name="Social Marketing" web_icon="base,static/img/icons/social.png" sequence="175"/>
    <menuitem id="menu_social_posts" name="Posts" parent="menu_social_root" action="action_social_post" sequence="10"/>
    <menuitem id="menu_social_campaigns" name="Campaigns" parent="menu_social_root" action="utm.utm_campaign_action" sequence="20"/>
</odoo>
