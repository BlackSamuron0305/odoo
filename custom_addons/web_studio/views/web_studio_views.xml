<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_web_studio_views" model="ir.actions.act_window">
        <field name="name">Views</field>
        <field name="res_model">ir.ui.view</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="action_web_studio_models" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">ir.model</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_web_studio_automations" model="ir.actions.act_window">
        <field name="name">Automated Actions</field>
        <field name="res_model">base.automation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_web_studio_root" name="Studio" web_icon="base,static/img/icons/web_studio.png" sequence="75"/>
    <menuitem id="menu_web_studio_views" name="Views" parent="menu_web_studio_root" action="action_web_studio_views" sequence="10"/>
    <menuitem id="menu_web_studio_models" name="Models" parent="menu_web_studio_root" action="action_web_studio_models" sequence="20" groups="base.group_no_one"/>
    <menuitem id="menu_web_studio_automations" name="Automated Actions" parent="menu_web_studio_root" action="action_web_studio_automations" sequence="30"/>
</odoo>
