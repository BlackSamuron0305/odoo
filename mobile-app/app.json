{
  "expo": {
    "name": "Odoo",
    "slug": "odoo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "odoo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#71639e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.odoo.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos to attach to records",
        "NSPhotoLibraryUsageDescription": "Choose photos to attach to records",
        "NSFaceIDUsageDescription": "Use Face ID to secure your session"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#71639e"
      },
      "package": "com.odoo.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        { "faceIDPermission": "Use Face ID to secure your Odoo session" }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Odoo to access your photos",
          "cameraPermission": "Allow Odoo to use the camera"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#71639e"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/odoo-mobile",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
